{
  "ConnectionStrings": {
    "EPiServerDB": "Data Source=(LocalDb)\\MSSQLLocalDB;Initial Catalog=AlloySampleSite;Integrated Security=True;Connect Timeout=30;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "EPiServer": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "urls": "http://*:8000/;",
  "AllowedHosts": "*",
  "EPiServer": {
    "Cms": {
      "MappedRoles": {
        "Items": {
          "CmsEditors": { "MappedRoles": [ "WebEditors", "WebAdmins" ] },
          "CmsAdmins": { "MappedRoles": [ "WebAdmins" ] }
        }
      }
    }
  }
}
